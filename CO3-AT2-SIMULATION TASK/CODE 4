clc;
clear;
clf;

// Time parameters
dt = 0.001;
t = 0:dt:5;

// Input signal x(t) = exp(-2t)u(t)
x = exp(-2*t);

// Impulse response h(t) = exp(-3t)u(t)
h = exp(-3*t);

// Convolution
y_conv = convol(x, h);

// Scale convolution by dt
y_conv = y_conv * dt;

// Time vector for convolution output
t_conv = 0:dt:(length(y_conv)-1)*dt;

// Analytical result
y_analytical = exp(-2*t) - exp(-3*t);

// Plot all signals
subplot(3,1,1);
plot(t, x);
xtitle("Input x(t) = exp(-2t)u(t)", "Time (s)", "x(t)");
xgrid();

subplot(3,1,2);
plot(t, h);
xtitle("Impulse Response h(t) = exp(-3t)u(t)", "Time (s)", "h(t)");
xgrid();

subplot(3,1,3);
plot(t_conv, y_conv);
plot(t, y_analytical, "r--");
xtitle("Convolution Output", "Time (s)", "y(t)");
legend("Numerical convolution", "Analytical result");
xgrid();

// Verification
error = max(abs(y_conv(1:length(t)) - y_analytical));

disp("Maximum error between numerical and analytical results:");
disp(error);
